// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Grid Scalper MA

//@version=5
strategy("Grid Scalper MA v2.1", overlay=true, initial_capital=1000, currency=currency.USD, max_bars_back=500, calc_on_every_tick=true, pyramiding=200)

// --- Enums / Types ---
// In Pine Script we use string inputs with options to mimic Enums

// --- Inputs ---
grp_main = "=== Main Settings ==="
magicNumber      = input.int(777007, "Magic Number", group=grp_main)
maxOpenOrders    = input.int(20, "Max Open Orders (per side)", group=grp_main)
comment          = input.string("GridScalper", "Order Comment", group=grp_main)
gridFrom         = input.string("Last Order", "Grid Reference", options=["Current Price", "Last Order"], group=grp_main)

grp_grid = "=== Grid Settings ==="
gridSize         = input.float(10.0, "Grid Step Size (points)", group=grp_grid)
useATRGridSize   = input.bool(false, "Use ATR-Based Grid Size", group=grp_grid)
atrPeriod        = input.int(14, "ATR Period", group=grp_grid)
atrMultiplier    = input.float(1.0, "ATR Multiplier", group=grp_grid)

grp_lot = "=== Lot Size ==="
lotMode          = input.string("Fixed", "Lot Mode", options=["Fixed", "Risk %", "Compound"], group=grp_lot)
fixedLot         = input.float(0.01, "Fixed Lot Size", group=grp_lot)
riskPercent      = input.float(1.0, "Risk Percent", group=grp_lot)
lotMultiplier    = input.float(1.5, "Compound Lot Multiplier", group=grp_lot)
maxMultiplierSteps = input.int(10, "Max Multiplier Steps", group=grp_lot)
maxLot           = input.float(10.0, "Maximum Lot Size", group=grp_lot)

grp_ma = "=== MA Filter ==="
maMode           = input.string("Slope Filter", "MA Mode", options=["Disabled", "Price Cross", "Slope Filter", "Trend Follow"], group=grp_ma)
fastMAPeriod     = input.int(50, "Fast MA Period", group=grp_ma)
slowMAPeriod     = input.int(200, "Slow MA Period", group=grp_ma)
maMethod         = input.string("SMA", "MA Method", options=["SMA", "EMA", "WMA"], group=grp_ma)
maPrice          = input.source(close, "MA Applied Price", group=grp_ma)

grp_rsi = "=== RSI Filter ==="
useRSI           = input.bool(false, "Enable RSI Filter", group=grp_rsi)
rsiPeriod        = input.int(14, "RSI Period", group=grp_rsi)
rsiOverbought    = input.float(70.0, "RSI Overbought Level", group=grp_rsi)
rsiOversold      = input.float(30.0, "RSI Oversold Level", group=grp_rsi)

grp_tp_sl = "=== Take Profit / Stop Loss ==="
tpPoints         = input.float(50.0, "Take Profit (points)", group=grp_tp_sl)
slPoints         = input.float(0.0, "Stop Loss (points, 0=off)", group=grp_tp_sl)
useBasketTP      = input.bool(true, "Use Basket TP", group=grp_tp_sl)
basketTP         = input.float(20.0, "Basket TP ($)", group=grp_tp_sl)
basketTrailingStart = input.float(10.0, "Basket Trailing Start ($)", group=grp_tp_sl)
basketTrailingStep  = input.float(2.0, "Basket Trailing Step ($)", group=grp_tp_sl)
useBasketSL      = input.bool(false, "Use Basket SL", group=grp_tp_sl)
basketSL         = input.float(50.0, "Basket SL ($)", group=grp_tp_sl)

grp_risk = "=== Risk Management ==="
maxEquityRiskPercent = input.float(20.0, "Max Equity Risk %", group=grp_risk)

// --- Indicator Calculations ---
getMA(source, length, method) =>
    switch method
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "WMA" => ta.wma(source, length)
        => ta.sma(source, length)

maFast = getMA(maPrice, fastMAPeriod, maMethod)
maSlow = getMA(maPrice, slowMAPeriod, maMethod)
rsiVal = ta.rsi(close, rsiPeriod)
atrVal = ta.atr(atrPeriod)

// --- Helper Functions ---
getGridStep() =>
    float step = gridSize
    if useATRGridSize
        step := (atrVal / syminfo.mintick) * atrMultiplier
    math.max(step, 1.0)

// --- State Management ---
var int buyTradeId = 0
var int sellTradeId = 0
var int buyCount = 0
var int sellCount = 0

// --- Filter Logic ---
isMaBullish() =>
    bool bias = true
    if maMode == "Price Cross"
        bias := ta.crossover(close, maFast)
    else if maMode == "Slope Filter"
        bias := maFast > maFast[1]
    else if maMode == "Trend Follow"
        bias := maFast > maSlow and maFast > maFast[1]
    bias or maMode == "Disabled"

isMaBearish() =>
    bool bias = true
    if maMode == "Price Cross"
        bias := ta.crossunder(close, maFast)
    else if maMode == "Slope Filter"
        bias := maFast < maFast[1]
    else if maMode == "Trend Follow"
        bias := maFast < maSlow and maFast < maFast[1]
    bias or maMode == "Disabled"

isRsiNotOverbought() => not useRSI or rsiVal < rsiOverbought
isRsiNotOversold() => not useRSI or rsiVal > rsiOversold

// --- Position Tracking ---
buyCount := 0
sellCount := 0
for i = 0 to strategy.opentrades - 1
    if strategy.opentrades.size(i) > 0
        buyCount += 1
    else if strategy.opentrades.size(i) < 0
        sellCount += 1

// --- Reference Price Logic ---
lastBuyPrice = na
lastSellPrice = na
for i = 0 to strategy.opentrades - 1
    if strategy.opentrades.size(i) > 0
        lastBuyPrice := strategy.opentrades.entry_price(i)
    else if strategy.opentrades.size(i) < 0
        lastSellPrice := strategy.opentrades.entry_price(i)


// --- Lot Calculation ---
calcLot(currentCount) =>
    float lot = fixedLot
    if lotMode == "Compound"
        lot := fixedLot * math.pow(lotMultiplier, math.min(currentCount, maxMultiplierSteps))
    else if lotMode == "Risk %"
        riskMoney = strategy.equity * riskPercent / 100.0
        slP = slPoints > 0 ? slPoints : gridSize * 3
        lot := riskMoney / (slP * syminfo.mintick * syminfo.pointvalue)
    math.min(lot, maxLot)

// --- Entry Logic ---
gridStepPrice = getGridStep() * syminfo.mintick

// Buy Signal
buyInitialSignal = buyCount == 0 and isMaBullish() and isRsiNotOverbought()
buyGridSignal = buyCount > 0 and buyCount < maxOpenOrders and low <= lastBuyPrice - gridStepPrice

if buyInitialSignal or buyGridSignal
    buyTradeId += 1
    strategy.entry("B" + str.tostring(buyTradeId), strategy.long, qty=calcLot(buyCount), comment=comment)

// Sell Signal
sellInitialSignal = sellCount == 0 and isMaBearish() and isRsiNotOversold()
sellGridSignal = sellCount > 0 and sellCount < maxOpenOrders and high >= lastSellPrice + gridStepPrice

if sellInitialSignal or sellGridSignal
    sellTradeId += 1
    strategy.entry("S" + str.tostring(sellTradeId), strategy.short, qty=calcLot(sellCount), comment=comment)

// --- Basket Management ---
var float buyTrailingLevel = na
var float sellTrailingLevel = na

// Calculate side-specific PnL
buyPnL = 0.0
sellPnL = 0.0
for i = 0 to strategy.opentrades - 1
    if strategy.opentrades.size(i) > 0
        buyPnL += strategy.opentrades.profit(i)
    else if strategy.opentrades.size(i) < 0
        sellPnL += strategy.opentrades.profit(i)

// Individual TP/SL
for i = 0 to strategy.opentrades - 1
    trade_id = strategy.opentrades.entry_id(i)
    strategy.exit("Exit" + trade_id, from_entry=trade_id, profit=tpPoints, loss=slPoints > 0 ? slPoints : na, comment_loss="SL", comment_profit="TP")

// Buy Basket Exit
if buyCount > 0
    if useBasketTP and buyPnL >= basketTP
        if buyPnL >= basketTrailingStart
            newTrail = buyPnL - basketTrailingStep
            if na(buyTrailingLevel) or newTrail > buyTrailingLevel
                buyTrailingLevel := newTrail

        if not na(buyTrailingLevel)
            if buyPnL <= buyTrailingLevel
                strategy.close_all(mode=strategy.long, comment="Buy Basket Trail Stop")
                buyTrailingLevel := na
        else
            strategy.close_all(mode=strategy.long, comment="Buy Basket TP")
            buyTrailingLevel := na
    else if useBasketSL and buyPnL <= -basketSL
        strategy.close_all(mode=strategy.long, comment="Buy Basket SL")
        buyTrailingLevel := na

    if buyPnL < 0
        buyTrailingLevel := na

// Sell Basket Exit
if sellCount > 0
    if useBasketTP and sellPnL >= basketTP
        if sellPnL >= basketTrailingStart
            newTrail = sellPnL - basketTrailingStep
            if na(sellTrailingLevel) or newTrail > sellTrailingLevel
                sellTrailingLevel := newTrail

        if not na(sellTrailingLevel)
            if sellPnL <= sellTrailingLevel
                strategy.close_all(mode=strategy.short, comment="Sell Basket Trail Stop")
                sellTrailingLevel := na
        else
            strategy.close_all(mode=strategy.short, comment="Sell Basket TP")
            sellTrailingLevel := na
    else if useBasketSL and sellPnL <= -basketSL
        strategy.close_all(mode=strategy.short, comment="Sell Basket SL")
        sellTrailingLevel := na

    if sellPnL < 0
        sellTrailingLevel := na

// Equity Protection
if maxEquityRiskPercent > 0 and strategy.openprofit <= -strategy.equity * maxEquityRiskPercent / 100.0
    strategy.close_all(comment="Equity Risk SL")

// --- Visuals ---
// Dashboard
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 50), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Grid Scalper MA", text_color=color.gold)
    table.cell(dash, 0, 1, "Buys: " + str.tostring(buyCount), text_color=color.lime)
    table.cell(dash, 0, 2, "Sells: " + str.tostring(sellCount), text_color=color.red)
    table.cell(dash, 0, 3, "P&L: $" + str.tostring(strategy.openprofit, "#.##"), text_color=strategy.openprofit >= 0 ? color.lime : color.red)

// Grid Lines (Visualizing next levels)
var line buyLine = na
var line sellLine = na
line.delete(buyLine)
line.delete(sellLine)
if buyCount > 0
    buyLine := line.new(bar_index, lastBuyPrice - gridStepPrice, bar_index + 1, lastBuyPrice - gridStepPrice, extend=extend.right, color=color.new(color.lime, 70), style=line.style_dotted)
if sellCount > 0
    sellLine := line.new(bar_index, lastSellPrice + gridStepPrice, bar_index + 1, lastSellPrice + gridStepPrice, extend=extend.right, color=color.new(color.red, 70), style=line.style_dotted)
