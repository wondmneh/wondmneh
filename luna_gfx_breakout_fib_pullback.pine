//@version=6
indicator("Breakout + Fib Pullback (Luna GFX)", "BO+Fib PB", overlay = true, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 500)

// ───────── Inputs ─────────
grpB = "1 · Bias (rising channel)"
useChannel = input.bool(true, "Require rising channel", group = grpB)
chLen      = input.int(100, "Channel length", minval = 20, group = grpB)
chMult     = input.float(2.0, "Channel width (std dev)", minval = 0.5, step = 0.1, group = grpB)
showCh     = input.bool(true, "Show channel", group = grpB)

grpS = "2 · Structure (BOS)"
swingLen = input.int(5, "Swing pivot length", minval = 2, group = grpS)
useBos   = input.bool(true, "Require bullish BOS (close above swing high)", group = grpS)
showBos  = input.bool(true, "Show BOS lines", group = grpS)

grpC = "3 · Consolidation breakout"
boxLen   = input.int(12, "Consolidation bars", minval = 3, group = grpC)
boxAtr   = input.float(2.5, "Max consolidation height (x ATR)", minval = 0.5, step = 0.1, group = grpC)
dispMult = input.float(1.0, "Breakout candle body (x ATR)", minval = 0.0, step = 0.1, group = grpC)

grpF = "4 · Fib pullback entry"
entryFib = input.float(0.5, "Entry level", minval = 0.236, maxval = 0.618, step = 0.01, group = grpF, tooltip = "Entry triggers when price pulls back to this retracement. Zone drawn is 0.5 - 0.618.")
stopFib  = input.float(0.786, "Stop level", minval = 0.65, maxval = 1.0, step = 0.001, group = grpF)
stopBuf  = input.float(0.1, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = grpF)
maxWait  = input.int(40, "Cancel setup after N bars without pullback", minval = 1, group = grpF)

grpV = "Display"
showStats = input.bool(true, "Show stats table", group = grpV)

// ───────── Helpers ─────────
atr = ta.atr(14)
fib(float hi, float lo, float r) => hi - (hi - lo) * r

// ───────── 1 · Channel bias ─────────
basis = ta.linreg(close, chLen, 0)
slope = basis - ta.linreg(close, chLen, 1)
dev   = ta.stdev(close, chLen) * chMult
upper = basis + dev
lower = basis - dev
channelUp = not useChannel or (slope > 0 and close > lower)

plot(showCh ? upper : na, "Channel top", color.new(color.teal, 40))
plot(showCh ? basis : na, "Channel mid", color.new(color.gray, 70))
plot(showCh ? lower : na, "Channel bottom", color.new(color.teal, 40))

// ───────── 2 · Structure: BOS needs a close, not a wick ─────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float lastPH = na
var int   lastPHBar = na
var float lastPL = na
var int   structure = 0

if not na(ph)
    lastPH := ph
    lastPHBar := bar_index - swingLen
if not na(pl)
    lastPL := pl

bosUp = not na(lastPH) and close > lastPH
bosDn = not na(lastPL) and close < lastPL
if bosUp
    structure := 1
    if showBos
        line.new(lastPHBar, lastPH, bar_index, lastPH, color = color.new(color.green, 20), style = line.style_dashed)
        label.new(bar_index, lastPH, "BOS", style = label.style_none, textcolor = color.green, size = size.small)
    lastPH := na
if bosDn
    structure := -1
    lastPL := na

// ───────── 3 · Consolidation + displacement breakout ─────────
boxTop = ta.highest(high, boxLen)[1]
boxBot = ta.lowest(low, boxLen)[1]
tight  = (boxTop - boxBot) <= boxAtr * atr[1]
breakout = tight and close > boxTop and close > open and (close - open) >= dispMult * atr[1]
setup = breakout and channelUp and (not useBos or structure == 1)

// ───────── 4 · State machine: 0 idle, 1 waiting for pullback, 2 in trade ─────────
var int   state = 0
var int   armBar = na
var float legHigh = na
var float legLow = na
var float entryPx = na
var float stopPx = na
var float targetPx = na
var int   wins = 0
var int   losses = 0

var line lEntry = na
var line lGold = na
var line lStop = na
var line lTgt = na
var box  zoneBox = na

armed = false
entered = false
tpHit = false
slHit = false
cancelled = false

if state == 0 and setup
    state := 1
    armed := true
    armBar := bar_index
    legHigh := high
    legLow := boxBot
    box.new(bar_index - boxLen, boxTop, bar_index, boxBot, border_color = color.new(color.orange, 20), bgcolor = color.new(color.orange, 88))
    lTgt   := line.new(bar_index, legHigh, bar_index + 1, legHigh, color = color.green)
    lEntry := line.new(bar_index, fib(legHigh, legLow, 0.5), bar_index + 1, fib(legHigh, legLow, 0.5), color = color.blue)
    lGold  := line.new(bar_index, fib(legHigh, legLow, 0.618), bar_index + 1, fib(legHigh, legLow, 0.618), color = color.blue)
    lStop  := line.new(bar_index, fib(legHigh, legLow, stopFib), bar_index + 1, fib(legHigh, legLow, stopFib), color = color.red)
    zoneBox := box.new(bar_index, fib(legHigh, legLow, 0.5), bar_index + 1, fib(legHigh, legLow, 0.618), border_color = na, bgcolor = color.new(color.blue, 82))
else if state == 1
    curEntry = fib(legHigh, legLow, entryFib)
    curStop  = fib(legHigh, legLow, stopFib)
    if high > legHigh
        // Impulse still extending: re-anchor the fib's 0 level
        legHigh := high
        line.set_y1(lTgt, legHigh)
        line.set_y2(lTgt, legHigh)
        line.set_y1(lEntry, fib(legHigh, legLow, 0.5))
        line.set_y2(lEntry, fib(legHigh, legLow, 0.5))
        line.set_y1(lGold, fib(legHigh, legLow, 0.618))
        line.set_y2(lGold, fib(legHigh, legLow, 0.618))
        line.set_y1(lStop, fib(legHigh, legLow, stopFib))
        line.set_y2(lStop, fib(legHigh, legLow, stopFib))
        box.set_top(zoneBox, fib(legHigh, legLow, 0.5))
        box.set_bottom(zoneBox, fib(legHigh, legLow, 0.618))
    else if low <= curStop
        // Impulse invalidated before entry: skip the trade
        state := 0
        cancelled := true
        label.new(bar_index, low, "Invalid", style = label.style_label_up, color = color.gray, textcolor = color.white, size = size.tiny)
    else if low <= curEntry
        state := 2
        entered := true
        entryPx := curEntry
        stopPx := curStop - stopBuf * atr
        targetPx := legHigh
        rr = (targetPx - entryPx) / (entryPx - stopPx)
        label.new(bar_index, low, "BUY\nSL " + str.tostring(stopPx, format.mintick) + "\nTP " + str.tostring(targetPx, format.mintick) + "\nRR 1:" + str.tostring(rr, "#.##"), style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)
        line.set_y1(lStop, stopPx)
        line.set_y2(lStop, stopPx)
    else if bar_index - armBar > maxWait
        state := 0
        cancelled := true
    if state != 0 or entered
        line.set_x2(lTgt, bar_index)
        line.set_x2(lEntry, bar_index)
        line.set_x2(lGold, bar_index)
        line.set_x2(lStop, bar_index)
        box.set_right(zoneBox, bar_index)
else if state == 2
    line.set_x2(lTgt, bar_index)
    line.set_x2(lEntry, bar_index)
    line.set_x2(lGold, bar_index)
    line.set_x2(lStop, bar_index)
    box.set_right(zoneBox, bar_index)
    // Stop is checked first, so a bar touching both counts as a loss
    if low <= stopPx
        state := 0
        slHit := true
        losses += 1
        label.new(bar_index, low, "SL", style = label.style_label_up, color = color.red, textcolor = color.white, size = size.tiny)
    else if high >= targetPx
        state := 0
        tpHit := true
        wins += 1
        label.new(bar_index, high, "TP", style = label.style_label_down, color = color.green, textcolor = color.white, size = size.tiny)

plotshape(armed, "Breakout (setup armed)", shape.triangleup, location.belowbar, color.orange, size = size.tiny)
bgcolor(state == 1 ? color.new(color.orange, 94) : state == 2 ? color.new(color.green, 94) : na, title = "Setup / trade background")

// ───────── Stats ─────────
if showStats and barstate.islast
    var table t = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 30), border_width = 1)
    total = wins + losses
    table.cell(t, 0, 0, "Wins", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, str.tostring(wins), text_color = color.green, text_size = size.small)
    table.cell(t, 0, 1, "Losses", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 1, str.tostring(losses), text_color = color.red, text_size = size.small)
    table.cell(t, 0, 2, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 2, total > 0 ? str.tostring(100.0 * wins / total, "#.#") + "%" : "-", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 3, "Status", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 3, state == 1 ? "Wait pullback" : state == 2 ? "In trade" : "Idle", text_color = color.white, text_size = size.small)

// ───────── Alerts ─────────
alertcondition(armed, "Setup armed", "Breakout confirmed - wait for the 0.5-0.618 pullback, do not chase")
alertcondition(entered, "Buy entry", "Price pulled back into the fib entry zone - long setup triggered")
alertcondition(tpHit, "Target hit", "Target (0 level / prior high) reached")
alertcondition(slHit, "Stop hit", "Stop below 0.786 hit")
alertcondition(cancelled, "Setup cancelled", "Setup invalidated or timed out before entry")
