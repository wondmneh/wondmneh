// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Grid Scalper MA

//@version=5
strategy("Grid Scalper MA Port", overlay=true, initial_capital=10000, currency=currency.USD, pyramiding=100, margin_long=0, margin_short=0, default_qty_type=strategy.fixed, explicit_plot_zorder=true, calc_on_every_tick=true, process_orders_on_close=true)

//+------------------------------------------------------------------+
//| ENUMS SIMULATION (via inputs)                                    |
//+------------------------------------------------------------------+
// MA Modes
MA_DISABLED = "Disabled"
MA_PRICE_CROSS = "Price Crosses MA"
MA_SLOPE_FILTER = "MA Slope Filter"
MA_TREND_FOLLOW = "MA Trend Follow"

// Lot Modes
LOT_FIXED = "Fixed Lot"
LOT_RISK = "Risk % of Balance"
LOT_COMPOUND = "Compound Growth"

// Grid Reference
GRID_FROM_CURRENT = "From Current Price"
GRID_FROM_LAST = "From Last Order Price"

//+------------------------------------------------------------------+
//| INPUT GROUPS                                                     |
//+------------------------------------------------------------------+
// === Main Settings ===
G_MAIN = "=== Main Settings ==="
inpAutoTrading = input.bool(true, "Enable Auto Trading", group=G_MAIN)
inpMaxOpenOrders = input.int(20, "Max Open Orders (per side)", minval=1, group=G_MAIN)
inpComment = input.string("GridScalper", "Order Comment", group=G_MAIN)
inpGridFrom = input.string(GRID_FROM_LAST, "Grid Reference (Visual Only)", options=[GRID_FROM_CURRENT, GRID_FROM_LAST], group=G_MAIN)

// === Grid Settings ===
G_GRID = "=== Grid Settings ==="
inpGridSize = input.float(10.0, "Grid Step Size (points/ticks)", minval=1.0, group=G_GRID)
inpUseATRGridSize = input.bool(false, "Use ATR-Based Grid Size", group=G_GRID)
inpATRPeriod = input.int(14, "ATR Period", minval=1, group=G_GRID)
inpATRMultiplier = input.float(1.0, "ATR Multiplier", minval=0.1, group=G_GRID)

// === Lot Size ===
G_LOT = "=== Lot Size ==="
inpLotMode = input.string(LOT_FIXED, "Lot Mode", options=[LOT_FIXED, LOT_RISK, LOT_COMPOUND], group=G_LOT)
inpFixedLot = input.float(0.01, "Initial/Fixed Lot Size (Lots)", minval=0.01, step=0.01, group=G_LOT)
inpUnitsPerLot = input.float(100000, "Units per 1.0 Lot", group=G_LOT, tooltip="e.g. 100,000 for standard Forex")
inpRiskPercent = input.float(1.0, "Risk Percent", minval=0.1, maxval=100.0, group=G_LOT)
inpLotMultiplier = input.float(1.5, "Martingale Multiplier", minval=1.0, group=G_LOT)
inpMaxMultiplierSteps = input.int(10, "Max Multiplier Steps", minval=1, group=G_LOT)
inpMaxLot = input.float(10.0, "Maximum Lot Size (Lots)", minval=0.01, group=G_LOT)

// === MA Filter ===
G_MA = "=== MA Filter ==="
inpMAMode = input.string(MA_SLOPE_FILTER, "MA Mode", options=[MA_DISABLED, MA_PRICE_CROSS, MA_SLOPE_FILTER, MA_TREND_FOLLOW], group=G_MA)
inpFastMA = input.int(50, "Fast MA Period", minval=1, group=G_MA)
inpSlowMA = input.int(200, "Slow MA Period", minval=1, group=G_MA)
inpMAMethod = input.string("SMA", "MA Method", options=["SMA", "EMA", "WMA", "HMA"], group=G_MA)
inpMASource = input.source(close, "MA Applied Price", group=G_MA)

// === RSI Filter ===
G_RSI = "=== RSI Filter ==="
inpUseRSI = input.bool(false, "Enable RSI Filter", group=G_RSI)
inpRSIPeriod = input.int(14, "RSI Period", minval=1, group=G_RSI)
inpRSIOverbought = input.float(70.0, "RSI Overbought Level", minval=50.0, maxval=100.0, group=G_RSI)
inpRSIOversold = input.float(30.0, "RSI Oversold Level", minval=0.0, maxval=50.0, group=G_RSI)

// === Geometry Guard ===
G_GEOM = "=== Geometry Guard ==="
inpGeometryGuard = input.bool(true, "Enable Geometry Guard", group=G_GEOM)
inpMaxBuys = input.int(10, "Max Buys", minval=1, group=G_GEOM)
inpMaxSells = input.int(10, "Max Sells", minval=1, group=G_GEOM)
inpMaxTotal = input.int(15, "Max Total Orders", minval=1, group=G_GEOM)

// === Take Profit / Stop Loss ===
G_TPSL = "=== Take Profit / Stop Loss ==="
inpTakeProfit = input.float(50.0, "Take Profit (points/ticks)", minval=0.0, group=G_TPSL)
inpStopLoss = input.float(0.0, "Stop Loss (points/ticks, 0=off)", minval=0.0, group=G_TPSL)
inpUseBasketTP = input.bool(true, "Use Basket TP ($)", group=G_TPSL)
inpBasketTP = input.float(20.0, "Basket TP ($)", minval=0.1, group=G_TPSL)
inpBasketTrailingStart = input.float(10.0, "Basket Trailing Start ($)", minval=0.0, group=G_TPSL)
inpBasketTrailingStep = input.float(2.0, "Basket Trailing Step ($)", minval=0.0, group=G_TPSL)
inpUseBasketSL = input.bool(false, "Use Basket SL ($)", group=G_TPSL)
inpBasketSL = input.float(50.0, "Basket SL ($)", minval=0.1, group=G_TPSL)
inpCooldownBars = input.int(5, "Cooldown After Basket Close (Bars)", minval=0, group=G_TPSL)

// === Risk Management ===
G_RISK = "=== Risk Management ==="
inpMaxEquityRiskPercent = input.float(20.0, "Max Equity Risk %", minval=0.0, maxval=100.0, group=G_RISK)
inpDailyProfitTarget = input.float(0.0, "Daily Profit Target ($, 0=off)", minval=0.0, group=G_RISK)
inpDailyLossLimit = input.float(50.0, "Daily Loss Limit ($)", minval=0.0, group=G_RISK)

// === Trading Hours ===
G_TIME = "=== Trading Hours ==="
inpUseTradingHours = input.bool(false, "Enable Trading Hours", group=G_TIME)
inpTimeSession = input.session("0800-2000", "Trading Session", group=G_TIME)
inpCloseOnFriday = input.bool(false, "Close All on Friday", group=G_TIME)

//+------------------------------------------------------------------+
//| INDICATORS                                                       |
//+------------------------------------------------------------------+
f_ma(src, len, type) =>
    type == "SMA" ? ta.sma(src, len) :
     type == "EMA" ? ta.ema(src, len) :
     type == "WMA" ? ta.wma(src, len) :
     ta.hma(src, len)

maFast = f_ma(inpMASource, inpFastMA, inpMAMethod)
maSlow = f_ma(inpMASource, inpSlowMA, inpMAMethod)
rsiVal = ta.rsi(close, inpRSIPeriod)
atrVal = ta.atr(inpATRPeriod)

//+------------------------------------------------------------------+
//| STATE VARIABLES                                                  |
//+------------------------------------------------------------------+
// Simulation of independent grids
var buy_prices = array.new_float(0)
var buy_lots   = array.new_float(0) // Lots in MT units (0.01 etc)
var sell_prices = array.new_float(0)
var sell_lots   = array.new_float(0) // Lots in MT units

var float basketTrailingLevel = 0.0
var int lastBasketCloseBar = -100
var float dailyStartingEquity = strategy.equity

// Reset daily equity
if ta.change(time("D"))
    dailyStartingEquity := strategy.equity

//+------------------------------------------------------------------+
//| CALCULATIONS                                                     |
//+------------------------------------------------------------------+
gridStepPoints = inpUseATRGridSize ? (atrVal / syminfo.mintick * inpATRMultiplier) : inpGridSize
gridStepPrice = gridStepPoints * syminfo.mintick

int buyCount = array.size(buy_prices)
int sellCount = array.size(sell_prices)
int totalCount = buyCount + sellCount

// Calculate current simulated profit
float currentProfit = 0.0
if buyCount > 0
    for i = 0 to buyCount - 1
        currentProfit += (close - array.get(buy_prices, i)) * syminfo.pointvalue * (array.get(buy_lots, i) * inpUnitsPerLot)
if sellCount > 0
    for i = 0 to sellCount - 1
        currentProfit += (array.get(sell_prices, i) - close) * syminfo.pointvalue * (array.get(sell_lots, i) * inpUnitsPerLot)

//+------------------------------------------------------------------+
//| SIGNALS                                                          |
//+------------------------------------------------------------------+
bool isInsideSession = not inpUseTradingHours or not na(time(timeframe.period, inpTimeSession))

// Filters for first trade
bool maBiasBullish = true
if inpMAMode != MA_DISABLED
    if inpMAMode == MA_PRICE_CROSS
        maBiasBullish := close[1] <= maFast[1] and close > maFast
    else if inpMAMode == MA_SLOPE_FILTER
        maBiasBullish := maFast > maFast[1]
    else if inpMAMode == MA_TREND_FOLLOW
        maBiasBullish := maFast > maSlow and maFast > maFast[1]

bool maBiasBearish = true
if inpMAMode != MA_DISABLED
    if inpMAMode == MA_PRICE_CROSS
        maBiasBearish := close[1] >= maFast[1] and close < maFast
    else if inpMAMode == MA_SLOPE_FILTER
        maBiasBearish := maFast < maFast[1]
    else if inpMAMode == MA_TREND_FOLLOW
        maBiasBearish := maFast < maSlow and maFast < maFast[1]

bool rsiBuyOk = not inpUseRSI or rsiVal < inpRSIOverbought
bool rsiSellOk = not inpUseRSI or rsiVal > inpRSIOversold

// Grid signals
float lastBuyPrice = buyCount > 0 ? array.get(buy_prices, buyCount - 1) : 0.0
float lastSellPrice = sellCount > 0 ? array.get(sell_prices, sellCount - 1) : 0.0

bool buyGridSignal = false
if buyCount == 0
    buyGridSignal := maBiasBullish and rsiBuyOk
else
    buyGridSignal := close <= lastBuyPrice - gridStepPrice

bool sellGridSignal = false
if sellCount == 0
    sellGridSignal := maBiasBearish and rsiSellOk
else
    sellGridSignal := close >= lastSellPrice + gridStepPrice

//+------------------------------------------------------------------+
//| LOT CALCULATION                                                  |
//+------------------------------------------------------------------+
f_calcLot(mode, count) =>
    float lot = inpFixedLot // in MT lots
    if mode == LOT_RISK
        float riskMoney = strategy.equity * inpRiskPercent / 100.0
        float slPoints = inpStopLoss > 0 ? inpStopLoss : inpGridSize * 3
        // lot = risk / (points * value_per_point_per_lot)
        lot := riskMoney / (slPoints * syminfo.mintick * syminfo.pointvalue * inpUnitsPerLot)
    else if mode == LOT_COMPOUND
        lot := inpFixedLot * math.pow(inpLotMultiplier, math.min(count, inpMaxMultiplierSteps))

    lot := math.max(0.01, math.min(inpMaxLot, lot))
    // Round to standard 0.01 lot step for MT simulation
    lot := math.floor(lot / 0.01) * 0.01
    lot

//+------------------------------------------------------------------+
//| EXECUTION & BASKET                                               |
//+------------------------------------------------------------------+
bool canTrade = inpAutoTrading and isInsideSession and (bar_index - lastBasketCloseBar) >= inpCooldownBars

// Equity protection
float dailyPnL = strategy.equity - dailyStartingEquity
bool dailyLimitHit = (inpDailyProfitTarget > 0 and dailyPnL >= inpDailyProfitTarget) or (inpDailyLossLimit > 0 and dailyPnL <= -inpDailyLossLimit)
bool equityRiskHit = inpMaxEquityRiskPercent > 0 and currentProfit < 0 and (-currentProfit) >= strategy.equity * inpMaxEquityRiskPercent / 100.0

bool forceClose = dailyLimitHit or equityRiskHit or (inpCloseOnFriday and dayofweek == dayofweek.friday and hour >= 20)

// Basket TP Logic
bool basketExit = false
if inpUseBasketTP
    if currentProfit >= inpBasketTP
        if currentProfit >= inpBasketTrailingStart
            float newTrail = currentProfit - inpBasketTrailingStep
            if basketTrailingLevel == 0 or newTrail > basketTrailingLevel
                basketTrailingLevel := newTrail

        if basketTrailingLevel > 0 and currentProfit <= basketTrailingLevel
            basketExit := true
        else if basketTrailingLevel == 0
            basketExit := true
    else if currentProfit < 0
        basketTrailingLevel := 0.0

if inpUseBasketSL and currentProfit <= -inpBasketSL
    basketExit := true

if basketExit or forceClose
    array.clear(buy_prices)
    array.clear(buy_lots)
    array.clear(sell_prices)
    array.clear(sell_lots)
    strategy.close_all(comment="Basket/Force Close")
    lastBasketCloseBar := bar_index
    basketTrailingLevel := 0.0
else if canTrade
    // Buy Logic
    bool buyAllowed = (not inpGeometryGuard or (buyCount < inpMaxBuys and totalCount < inpMaxTotal)) and buyCount < inpMaxOpenOrders
    if buyGridSignal and buyAllowed
        float lot = f_calcLot(inpLotMode, buyCount)
        array.push(buy_prices, close)
        array.push(buy_lots, lot)

    // Sell Logic
    bool sellAllowed = (not inpGeometryGuard or (sellCount < inpMaxSells and totalCount < inpMaxTotal)) and sellCount < inpMaxOpenOrders
    if sellGridSignal and sellAllowed
        float lot = f_calcLot(inpLotMode, sellCount)
        array.push(sell_prices, close)
        array.push(sell_lots, lot)

    // Sync strategy position
    float targetBuyUnits = 0.0
    if array.size(buy_lots) > 0
        for i = 0 to array.size(buy_lots) - 1
            targetBuyUnits += array.get(buy_lots, i) * inpUnitsPerLot

    float targetSellUnits = 0.0
    if array.size(sell_lots) > 0
        for i = 0 to array.size(sell_lots) - 1
            targetSellUnits += array.get(sell_lots, i) * inpUnitsPerLot

    float targetNetUnits = targetBuyUnits - targetSellUnits
    float currentNetUnits = strategy.position_size
    float deltaUnits = targetNetUnits - currentNetUnits

    if deltaUnits != 0
        strategy.order("GridOrder", deltaUnits > 0 ? strategy.long : strategy.short, qty=math.abs(deltaUnits), comment=inpComment)

//+------------------------------------------------------------------+
//| VISUALS                                                          |
//+------------------------------------------------------------------+
// Grid lines simulation
if barstate.islast
    float refBuy = inpGridFrom == GRID_FROM_LAST and buyCount > 0 ? lastBuyPrice : close
    float refSell = inpGridFrom == GRID_FROM_LAST and sellCount > 0 ? lastSellPrice : close

    // Draw next potential levels
    line.new(bar_index[10], refBuy - gridStepPrice, bar_index, refBuy - gridStepPrice, color=color.new(color.lime, 50), style=line.style_dashed)
    line.new(bar_index[10], refSell + gridStepPrice, bar_index, refSell + gridStepPrice, color=color.new(color.red, 50), style=line.style_dashed)

    // Draw active grid levels (last 5)
    if buyCount > 0
        for i = math.max(0, buyCount - 5) to buyCount - 1
            line.new(bar_index[20], array.get(buy_prices, i), bar_index, array.get(buy_prices, i), color=color.lime, style=line.style_dotted, width=1)
    if sellCount > 0
        for i = math.max(0, sellCount - 5) to sellCount - 1
            line.new(bar_index[20], array.get(sell_prices, i), bar_index, array.get(sell_prices, i), color=color.red, style=line.style_dotted, width=1)

// Dashboard
var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 50), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Buys: " + str.tostring(buyCount), text_color=color.lime)
    table.cell(dash, 1, 0, "Sells: " + str.tostring(sellCount), text_color=color.red)
    table.cell(dash, 0, 1, "P&L: $" + str.tostring(currentProfit, "#.##"), text_color=currentProfit >= 0 ? color.lime : color.red)
    table.cell(dash, 0, 2, "Trail: $" + str.tostring(basketTrailingLevel, "#.##"), text_color=color.aqua)
    table.cell(dash, 0, 3, "Grid Step: " + str.tostring(gridStepPoints, "#.#"), text_color=color.white)
    table.cell(dash, 0, 4, "Equity: $" + str.tostring(strategy.equity, "#.##"), text_color=color.yellow)
